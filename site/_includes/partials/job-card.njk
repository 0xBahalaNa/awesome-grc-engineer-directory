<article
  class="card job-card"
  data-title="{{ job.data.title | lower }}"
  data-company="{{ job.data.company | lower }}"
  data-location="{{ (job.data.location or '') | lower }}"
  data-specializations="{{ (job.data.specializations or []) | join(',') | lower }}"
  data-frameworks="{{ (job.data.frameworks or []) | join(',') | lower }}"
  data-work-modes="{{ (job.data.work_modes or []) | join(',') | lower }}"
  data-job-types="{{ (job.data.job_types or []) | join(',') | lower }}"
  data-sources="{{ (job.data.sources or []) | join(',') | lower }}"
  data-posted="{{ job.data.posted_date or '' }}"
>
  <div class="job-card-role">
    <div class="job-card-eyebrow">
      {% if job.data.sources and job.data.sources.length %}
      <span class="job-source">{{ job.data.sources[0] }}</span>
      {% endif %}
    </div>

    <a href="{{ job.url }}" class="card-name job-card-title">{{ job.data.title }}</a>

    {% if job.data.summary %}
    <p class="job-card-summary">{{ job.data.summary }}</p>
    {% endif %}
  </div>

  <div class="job-card-company-cell">
    <p class="job-card-company">{{ job.data.company }}</p>
    {% if job.data.location %}<p class="job-card-location">{{ job.data.location }}</p>{% endif %}
    {% if job.data.compensation %}<p class="job-card-pay">{{ job.data.compensation }}</p>{% endif %}
  </div>

  <div class="job-card-work">
    {% if job.data.work_modes and job.data.work_modes.length %}
      {% for mode in job.data.work_modes %}
        {% if loop.index0 < 2 %}<span class="tag tag-muted">{{ mode }}</span>{% endif %}
      {% endfor %}
    {% endif %}
    {% if job.data.job_types and job.data.job_types.length %}
      {% for type in job.data.job_types %}
        {% if loop.index0 < 2 %}<span class="tag tag-outline">{{ type }}</span>{% endif %}
      {% endfor %}
    {% endif %}
  </div>

  <div class="job-card-skills">
    {% if job.data.specializations and job.data.specializations.length %}
    <div class="card-tags">
      {% for spec in job.data.specializations %}
        {% if loop.index0 < 2 %}
        <span class="tag tag-accent">{{ spec }}</span>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    {% if job.data.frameworks and job.data.frameworks.length %}
    <div class="card-tags">
      {% for framework in job.data.frameworks %}
        {% if loop.index0 < 2 %}
        <span class="tag tag-outline">{{ framework }}</span>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>

  <div class="job-card-posted-cell">
    {% if job.data.posted_date %}
      <span>Posted</span>
      <strong>{{ job.data.posted_date | readableDate }}</strong>
    {% else %}
      <span>Posted</span>
      <strong>Not listed</strong>
    {% endif %}
  </div>

  <div class="job-card-actions">
    <a href="{{ job.url }}" class="btn btn-outline btn-compact">View role</a>
    {% if job.data.apply_url %}
    <a href="{{ job.data.apply_url }}" class="btn btn-primary btn-compact" target="_blank" rel="noopener">Apply</a>
    {% endif %}
  </div>
</article>
